{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "promptub",
  "version": "0.3.1",
  "identifier": "com.promptub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "promptub",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "focus": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://i.ytimg.com data:; media-src 'self' https: http: blob: data:; connect-src 'self' ipc: http://ipc.localhost https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/tools/": "tools/"
    },
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false,
        "installMode": "both",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
